# 02. Import and validate -------------------------------------------------
raw <- read_csv(input_file, show_col_types = FALSE)
stopifnot(all(c("DateTime", "Salinity", "Temperature") %in% names(raw)))
if ("review_decision" %in% names(raw)) {
  decision <- toupper(trimws(as.character(raw$review_decision)))
  if (anyNA(decision) || any(!decision %in% c("KEEP", "REMOVE"))) stop("Resolve all review decisions.")
  raw <- raw[decision == "KEEP", , drop = FALSE]
}
dat <- raw %>% transmute(DateTime = suppressWarnings(ymd_hms(as.character(DateTime), tz = "UTC", quiet = TRUE)),
                         Salinity = suppressWarnings(as.numeric(Salinity)),
                         Temperature = suppressWarnings(as.numeric(Temperature))) %>% arrange(DateTime) %>%
  mutate(Date = as.Date(DateTime, tz = "UTC"), Season = if_else(month(Date) %in% c(11, 12, 1, 2, 3, 4), "W", "S"))
if (!nrow(dat) || anyNA(datDateTime)||anyDuplicated(datDateTime) ||
    any(!is.finite(datSalinity))||any(!is.finite(datTemperature))) stop("Invalid, missing or duplicate observations.")
if (any(minute(datDateTime)%%30!=0|second(datDateTime) != 0)) stop("Timestamps must align to half-hour intervals.")
gaps <- dat %>% mutate(gap_minutes = as.numeric(difftime(DateTime, lag(DateTime), units = "mins"))) %>%
  filter(!is.na(gap_minutes), gap_minutes != 30)
write_csv(gaps, file.path(output_dir, paste0(site_code, "_timestamp_gaps.csv")))

# 03. Daily and seasonal environmental summaries -------------------------
daily <- dat %>% group_by(Date, Season) %>% summarise(n_observations = n(),
  mean_salinity = mean(Salinity), min_salinity = min(Salinity), max_salinity = max(Salinity),
  mean_temperature = mean(Temperature), min_temperature = min(Temperature), max_temperature = max(Temperature), .groups = "drop") %>%
  mutate(site = site_code, .before = 1)
write_csv(daily, file.path(output_dir, paste0(site_code, "_daily_summary.csv")))
summarize_period <- function(period) {
  d <- if (period == "All") daily else filter(daily, Season == period)
  if (!nrow(d)) return(tibble())
  tibble(Site = site_code, Population = site_name, Period = period, Days = nrow(d),
    Temperature_Mean = mean(dmeantemperature),TemperatureSD=sd(dmean_temperature),
    Temperature_DailyMean_Min = min(dmeantemperature),TemperatureDailyMeanMax=max(dmean_temperature),
    Temperature_Observed_Min = min(dmintemperature),TemperatureObservedMax=max(dmax_temperature),
    Salinity_Mean = mean(dmeansalinity),SalinitySD=sd(dmean_salinity),
    Salinity_DailyMean_Min = min(dmeansalinity),SalinityDailyMeanMax=max(dmean_salinity),
    Salinity_Observed_Min = min(dminsalinity),SalinityObservedMax=max(dmax_salinity))
}
seasonal_summary <- map_dfr(c("W", "S", "All"), summarize_period)
write_csv(seasonal_summary, file.path(output_dir, paste0(site_code, "_seasonal_summary.csv")))

# 04. Threshold definitions -----------------------------------------------
threshold_key <- tibble(Environment = c(rep("Salinity", 5), rep("Temperature", 4)),
 threshold_id = c("sal_le23", "sal_le27", "sal_ge28", "sal_ge30", "sal_ge32",
                  "temp_le12", "temp_le13", "temp_14to18", "temp_gt18"),
 Threshold = c("≤23 PSU", "≤27 PSU", "≥28 PSU", "≥30 PSU", "≥32 PSU",
               "≤12°C", "≤13°C", "14–18°C", ">18°C"))
threshold_functions <- list(
 sal_le23 = function(s,t) s <= 23, sal_le27 = function(s,t) s <= 27,
 sal_ge28 = function(s,t) s >= 28, sal_ge30 = function(s,t) s >= 30,
 sal_ge32 = function(s,t) s >= 32, temp_le12 = function(s,t) t <= 12,
 temp_le13 = function(s,t) t <= 13, temp_14to18 = function(s,t) t >= 14 & t <= 18,
 temp_gt18 = function(s,t) t > 18)

# 05. Frequency, persistence and cumulative exposure ---------------------
calendar <- tibble(Date = seq(min(datDate),max(datDate), by = "day"))
calculate_threshold <- function(id) {
  exposed <- threshold_functions[[id]](datSalinity,datTemperature)
  exposure_daily <- tibble(Date = dat$Date, exposed = exposed) %>% group_by(Date) %>%
    summarise(exposure_day = any(exposed), .groups = "drop") %>%
    right_join(calendar, by = "Date") %>% arrange(Date) %>%
    mutate(exposure_day = replace_na(exposure_day, FALSE))
  runs <- rle(exposure_daily$exposure_day)
  persistence <- if (any(runsvalues))max(runslengths[runs$values]) else 0L
  tibble(threshold_id = id, Frequency_days = sum(exposure_daily$exposure_day),
         Persistence_days = persistence, Cumulative_hours = sum(exposed) * .5)
}
threshold_results <- map_dfr(threshold_key$threshold_id, calculate_threshold) %>%
  left_join(threshold_key, by = "threshold_id") %>%
  mutate(Site = site_code, Population = site_name, Monitoring_hours = nrow(dat) * .5,
         Monitoring_days = n_distinct(dat$Date), Calendar_days = nrow(calendar)) %>%
  select(Site, Population, Monitoring_hours, Monitoring_days, Calendar_days,
         Environment, Threshold, threshold_id, Frequency_days, Persistence_days, Cumulative_hours)
write_csv(threshold_results, file.path(output_dir, paste0(site_code, "_threshold_results.csv")))
print(seasonal_summary, width = Inf)
print(threshold_results, n = Inf, width = Inf)

