library(tidyverse)
library(lubridate)

# 01. Input and site naming -----------------------------------------------
input_file <- "insert csv here" # Raw 30-minute logger CSV with DateTime (YYYY-MM-DD HH:MM:SS), Salinity (PSU), Temperature (degrees C)
site_code <- "insert name here" # Short site code
site_name <- "insert name here" # Full sampling site name
reviewed_file <- "insert csv here" # AFTER manual review: exported all_observations_with_QC_flags.csv, with every review_decision changed to KEEP or REMOVE; leave placeholder for initial run
output_dir <- paste0(site_code, "_environmental_QC_outputs")
dir.create(output_dir, recursive = TRUE, showWarnings = FALSE)

# 02. Import --------------------------------------------------------------
raw <- readr::read_csv(input_file, show_col_types = FALSE)
stopifnot(all(c("DateTime", "Salinity", "Temperature") %in% names(raw)))
parse_times <- function(x) {
  out <- suppressWarnings(ymd_hms(trimws(as.character(x)), tz = "UTC", quiet = TRUE))
  if (anyNA(out)) stop("Unparseable DateTime values; expected YYYY-MM-DD HH:MM:SS.")
  out
}
dat <- raw %>% transmute(DateTime = parse_times(DateTime),
                         Salinity = suppressWarnings(as.numeric(Salinity)),
                         Temperature = suppressWarnings(as.numeric(Temperature))) %>% arrange(DateTime)
if (!nrow(dat) || anyDuplicated(dat$DateTime)) stop("Empty dataset or duplicate timestamps.")

# 03. QC settings ---------------------------------------------------------
iqr_multiplier <- 1.5
expected_interval_minutes <- 30
rate_mad_multiplier <- 6
neighbor_mad_multiplier <- 6
min_salinity_review <- 5 # Review criterion only; not an automatic exclusion

# 04. Flagging ------------------------------------------------------------
robust_limit <- function(x, multiplier) {
  x <- x[is.finite(x)]
  if (length(x) < 5) return(Inf)
  center <- median(x)
  spread <- mad(x, center = center, constant = 1.4826)
  if (!is.finite(spread) || spread == 0) return(Inf)
  center + multiplier * spread
}
flag_variable <- function(df, variable) {
  x <- df[[variable]]
  valid <- x[is.finite(x)]
  if (length(valid) < 4) stop(paste("Insufficient observations for", variable))
  q <- quantile(valid, c(.25, .75), names = FALSE)
  low <- q[1] - iqr_multiplier * (q[2] - q[1])
  high <- q[2] + iqr_multiplier * (q[2] - q[1])
  prev_gap <- as.numeric(difftime(dfDateTime,lag(dfDateTime), units = "mins"))
  next_gap <- as.numeric(difftime(lead(dfDateTime),dfDateTime, units = "mins"))
  adjacent_prev <- !is.na(prev_gap) & prev_gap == expected_interval_minutes
  adjacent_next <- !is.na(next_gap) & next_gap == expected_interval_minutes
  change <- abs(x - lag(x)); change[!adjacent_prev] <- NA_real_
  rate_cutoff <- robust_limit(change, rate_mad_multiplier)
  deviation <- abs(x - (lag(x) + lead(x)) / 2)
  deviation[!(adjacent_prev & adjacent_next & is.finite(lag(x)) & is.finite(lead(x)))] <- NA_real_
  neighbor_cutoff <- robust_limit(deviation, neighbor_mad_multiplier)
  tibble(!!paste0(variable, "_iqr_flag") := replace_na(is.finite(x) & (x < low | x > high), FALSE),
         !!paste0(variable, "_rate_flag") := replace_na(change > rate_cutoff, FALSE),
         !!paste0(variable, "_spike_flag") := replace_na(deviation > neighbor_cutoff &
           abs(x - lag(x)) > rate_cutoff & abs(lead(x) - x) > rate_cutoff, FALSE),
         !!paste0(variable, "_missing_flag") := !is.finite(x))
}
qc <- bind_cols(dat, flag_variable(dat, "Salinity"), flag_variable(dat, "Temperature")) %>%
  mutate(Salinity_below_5_flag = replace_na(is.finite(Salinity) & Salinity < min_salinity_review, FALSE),
         any_flag = if_any(ends_with("_flag"), identity),
         review_decision = if_else(any_flag, "REVIEW", "KEEP"),
         review_reason = case_when(Salinity_below_5_flag ~ "Check tidal exposure and sensor record",
                                   any_flag ~ "Inspect surrounding values and sensor record", TRUE ~ ""))
summary_qc <- qc %>% summarise(total_records = n(), flagged_records = sum(any_flag),
                               across(ends_with("_flag"), ~ sum(.x, na.rm = TRUE)))
write_csv(qc, file.path(output_dir, paste0(site_code, "_all_observations_with_QC_flags.csv")))
write_csv(filter(qc, any_flag), file.path(output_dir, paste0(site_code, "_flagged_observations_for_review.csv")))
write_csv(summary_qc, file.path(output_dir, paste0(site_code, "_QC_summary.csv")))

# 05. Visual review -------------------------------------------------------
for (variable in c("Salinity", "Temperature")) {
  flags <- grep(paste0("^", variable, "_.*_flag$"), names(qc), value = TRUE)
  selected <- qc %>% filter(if_any(all_of(flags), identity))
  p <- ggplot(qc, aes(DateTime, .data[[variable]])) +
    geom_line(color = "grey45", linewidth = .25, na.rm = TRUE) +
    geom_point(data = selected, color = "#C62828", size = .8, na.rm = TRUE) +
    labs(title = paste(site_name, variable, "QC"), x = "Date", y = if (variable == "Salinity") "Salinity (PSU)" else "Temperature (°C)") +
    theme_classic(base_size = 12)
  ggsave(file.path(output_dir, paste0(site_code, "_", tolower(variable), "_QC.png")), p, width = 12, height = 5, dpi = 300)
}

# 06. Apply manual review -------------------------------------------------
if (reviewed_file != "insert csv here") {
  reviewed <- read_csv(reviewed_file, show_col_types = FALSE)
  stopifnot(all(c("DateTime", "Salinity", "Temperature", "review_decision") %in% names(reviewed)))
  reviewed <- reviewed %>% mutate(DateTime = parse_times(DateTime),
                                   review_decision = toupper(trimws(as.character(review_decision))))
  if (anyNA(reviewedreviewdecision)||any(!reviewedreview_decision %in% c("KEEP", "REMOVE"))) stop("Resolve every decision to KEEP or REMOVE.")
  if (nrow(reviewed) != nrow(qc) || anyDuplicated(reviewed$DateTime) ||
      !setequal(reviewedDateTime,qcDateTime)) stop("Reviewed timestamps do not match original observations.")
  cleaned <- reviewed %>% filter(review_decision == "KEEP") %>%
    transmute(DateTime, Salinity = as.numeric(Salinity), Temperature = as.numeric(Temperature)) %>% arrange(DateTime)
  if (any(!is.finite(cleanedSalinity))||any(!is.finite(cleanedTemperature))) stop("KEEP observations contain missing or nonnumeric values.")
  write_csv(cleaned, file.path(output_dir, paste0(site_code, "_environmental_cleaned.csv")))
  write_csv(count(reviewed, review_decision), file.path(output_dir, paste0(site_code, "_QC_decision_summary.csv")))
}
