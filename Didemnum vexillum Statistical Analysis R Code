packages <- c("tidyverse", "adegenet", "hierfstat", "ggrepel")
missing_packages <- setdiff(packages, rownames(installed.packages()))
if (length(missing_packages)) install.packages(missing_packages)
invisible(lapply(packages, library, character.only = TRUE))

# 01. Input ---------------------------------------------------------------
genotype_file <- "insert csv here" # Diploid microsatellite CSV: site, sample_id, followed by two allele-size columns per locus in the order listed below; one row per individual
output_dir <- "genetic_outputs"
dir.create(output_dir, recursive = TRUE, showWarnings = FALSE)
loci <- c("Dvex3", "Dvex5", "Dvex12", "Dvex20", "Dvex23", "Dvex26", "Dvex30", "Dvex32", "Dvex42")
site_levels <- c("DE", "FB", "HMB", "SFYC", "PB")
site_labels <- c(DE = "Drakes Estero", FB = "Fort Baker", HMB = "Half Moon Bay", SFYC = "St. Francis Yacht Club", PB = "Point Bonita")
site_colors <- c(DE = "#A64CE6", FB = "#C8B900", HMB = "#1565D8", SFYC = "#14B83A", PB = "#D95F02")
normalize_site <- function(x) {
  x <- trimws(as.character(x))
  dplyr::recode(x, "1" = "PB", "2" = "HMB", "3" = "FB", "4" = "SFYC", "5" = "DE",
                "Drakes Estero" = "DE", "Fort Baker" = "FB", "Half Moon Bay" = "HMB",
                "St. Francis Yacht Club" = "SFYC", "Point Bonita" = "PB", .default = x)
}
write_out <- function(x, name) readr::write_csv(x, file.path(output_dir, name))
save_plot <- function(p, name, w = 12, h = 7) ggplot2::ggsave(file.path(output_dir, name), p, width = w, height = h, dpi = 300)

# 02. Import and validate -------------------------------------------------
raw <- readr::read_csv(genotype_file, show_col_types = FALSE, name_repair = "minimal")
stopifnot(ncol(raw) >= 2 + 2 * length(loci))
geno <- as_tibble(raw[, seq_len(2 + 2 * length(loci))])
names(geno) <- c("site", "sample_id", as.vector(rbind(paste0(loci, "_A1"), paste0(loci, "_A2"))))
geno <- geno %>% mutate(site = normalize_site(site), sample_id = as.character(sample_id),
                        across(matches("_A[12]$"), ~ suppressWarnings(as.numeric(.x))))
stopifnot(all(genosite%in%sitelevels),!anyNA(genosample_id),
          !anyDuplicated(paste(genosite,genosample_id)))
geno <- geno %>% mutate(individual = paste(site, sample_id, sep = "_"))
for (loc in loci) {
  a <- paste0(loc, "_A1"); b <- paste0(loc, "_A2")
  geno[[a]][geno[[a]] == 0] <- NA_real_
  geno[[b]][geno[[b]] == 0] <- NA_real_
  partial <- xor(is.na(geno[[a]]), is.na(geno[[b]]))
  geno[[a]][partial] <- NA_real_; geno[[b]][partial] <- NA_real_
}
geno_long <- purrr::map_dfr(loci, function(loc) {
  tibble(site = genosite,individual=genoindividual, locus = loc,
         A1 = geno[[paste0(loc, "_A1")]], A2 = geno[[paste0(loc, "_A2")]])
}) %>% mutate(heterozygosity = case_when(is.na(A1) | is.na(A2) ~ NA_integer_, A1 != A2 ~ 1L, TRUE ~ 0L))
write_out(geno_long, "genotype_locus_heterozygosity.csv")
write_out(geno_long %>% group_by(site, locus) %>% summarise(n_samples = n(), n_missing = sum(is.na(heterozygosity)), proportion_missing = n_missing / n_samples, .groups = "drop"), "genotype_missingness.csv")

# 03. Diversity -----------------------------------------------------------
geno_strings <- geno %>% select(site, individual)
for (loc in loci) {
  a <- geno[[paste0(loc, "_A1")]]; b <- geno[[paste0(loc, "_A2")]]
  geno_strings[[loc]] <- ifelse(is.na(a) | is.na(b), NA_character_, paste(a, b, sep = "/"))
}
gi <- adegenet::df2genind(as.data.frame(geno_strings[, loci]), sep = "/", ploidy = 2,
                          ind.names = geno_stringsindividual,pop=factor(genostringssite),
                          type = "codom", NA.char = "NA")
hf <- hierfstat::genind2hierfstat(gi)
bs <- hierfstat::basic.stats(hf)
ar <- hierfstat::allelic.richness(hf)$Ar
pops <- levels(adegenet::pop(gi))
site_metric <- function(mat) {
  z <- colMeans(mat, na.rm = TRUE)
  as.numeric(z[pops])
}
alleles <- geno_long %>% filter(!is.na(A1), !is.na(A2)) %>%
  pivot_longer(c(A1, A2), names_to = "copy", values_to = "allele")
allele_counts <- alleles %>% group_by(site, locus) %>% summarise(n_alleles = n_distinct(allele), .groups = "drop")
allele_frequencies <- alleles %>% count(site, locus, allele, name = "count") %>%
  group_by(site, locus) %>% mutate(frequency = count / sum(count)) %>% ungroup()
private_alleles <- allele_frequencies %>% group_by(locus, allele) %>% filter(n_distinct(site) == 1) %>% ungroup()
mlg <- geno_strings %>% rowwise() %>% mutate(
  mlg_key = paste(vapply(loci, function(loc) {
    val <- .data[[loc]]
    if (is.na(val)) return("NA")
    paste(sort(as.numeric(strsplit(val, "/", fixed = TRUE)[[1]])), collapse = "/")
  }, character(1)), collapse = "|")) %>% ungroup() %>%
  group_by(site) %>% summarise(MLG = n_distinct(mlg_key), .groups = "drop")
site_diversity <- tibble(site = pops, N = as.integer(table(factor(geno_strings$site, levels = pops))),
                         Ho = site_metric(bsHo),He=sitemetric(bsHs), Fis = site_metric(bs$Fis),
                         Allelic_Richness = site_metric(ar)) %>%
  left_join(allele_counts %>% group_by(site) %>% summarise(NA_mean = mean(n_alleles), .groups = "drop"), by = "site") %>%
  left_join(private_alleles %>% count(site, name = "Private_Alleles"), by = "site") %>%
  left_join(mlg, by = "site") %>% mutate(Private_Alleles = replace_na(Private_Alleles, 0L))
write_out(allele_counts, "allele_counts.csv")
write_out(allele_frequencies, "allele_frequencies.csv")
write_out(private_alleles, "private_alleles.csv")
write_out(site_diversity, "genetic_diversity_summary.csv")

# 04. Allele-frequency figure ---------------------------------------------
p <- ggplot(allele_frequencies, aes(factor(allele), frequency, fill = site)) +
  geom_col(position = position_dodge(width = 0.85), width = 0.8) +
  facet_wrap(~ locus, scales = "free_x", ncol = 3) +
  scale_fill_manual(values = site_colors) +
  labs(x = "Allele size (bp)", y = "Allele frequency", fill = "Population") +
  theme_classic(base_size = 11) + theme(axis.text.x = element_text(angle = 90, hjust = 1))
save_plot(p, "allele_frequencies.png", 15, 11)

# 05. Pairwise FST --------------------------------------------------------
fst <- hierfstat::pairwise.WCfst(hf)
fst_table <- as.data.frame(as.table(as.matrix(fst))) %>%
  setNames(c("site_1", "site_2", "Fst")) %>%
  mutate(across(c(site_1, site_2), as.character)) %>%
  filter(site_1 < site_2, is.finite(Fst)) %>%
  mutate(pair = paste(site_1, site_2, sep = " vs "))
write_out(fst_table, "pairwise_Fst.csv")
p <- ggplot(fst_table, aes(Fst, reorder(pair, Fst))) +
  geom_vline(xintercept = 0, linetype = "dashed", color = "grey60") +
  geom_point(size = 3) + labs(x = "Pairwise FST", y = "Population pair") + theme_classic(base_size = 12)
save_plot(p, "pairwise_Fst_points.png", 9, 6)

