library(tidyverse)
library(lubridate)

# 01. Input and site naming -----------------------------------------------
input_file <- "insert csv here" # Manually cleaned 30-minute logger CSV with DateTime (YYYY-MM-DD HH:MM:SS), Salinity (PSU), Temperature (degrees C); no unreviewed records
site_code <- "insert name here" # Short site code
site_name <- "insert name here" # Full site name
output_dir <- paste0(site_code, "_environmental_summary_outputs")
