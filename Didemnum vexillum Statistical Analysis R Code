library(tidyverse)
library(lme4)

# 01. Input files ---------------------------------------------------------
heterozygosity_file <- "insert csv here" # Output genotype_locus_heterozygosity.csv from 01_genetics.R; columns site, individual, locus, heterozygosity (0/1/NA)
threshold_file <- "insert csv here" # Combined site threshold CSV: Site, Environment, Threshold, threshold_id, Frequency_days, Persistence_days, Cumulative_hours; one row per site and threshold
output_dir <- "GLMM_threshold_outputs"
dir.create(output_dir, recursive = TRUE, showWarnings = FALSE)
site_codes <- c("DE", "FB", "HMB", "SFYC") # Sites with environmental logger data; edit to match available data

# 02. Import and validate -------------------------------------------------
response <- read_csv(heterozygosity_file, show_col_types = FALSE) %>%
  filter(site %in% site_codes, !is.na(heterozygosity)) %>%
  mutate(locus = factor(locus), heterozygosity = as.integer(heterozygosity))
stopifnot(all(c("site", "individual", "locus", "heterozygosity") %in% names(response)),
          all(response$heterozygosity %in% c(0L, 1L)))
stress <- read_csv(threshold_file, show_col_types = FALSE) %>%
  rename(site = Site, environment = Environment, threshold = Threshold,
         frequency_days = Frequency_days, persistence_days = Persistence_days,
         cumulative_hours = Cumulative_hours) %>%
  filter(site %in% site_codes)
stopifnot(all(c("site", "environment", "threshold", "threshold_id", "frequency_days",
                "persistence_days", "cumulative_hours") %in% names(stress)))
if (anyDuplicated(stress[c("site", "threshold_id")])) stop("Duplicate site-threshold combinations.")
if (n_distinct(response$site) < 3) stop("At least three sites are needed for this exploratory model.")
if (!setequal(unique(responsesite),unique(stresssite))) stop("Response and exposure site sets differ.")

# 03. Prepare predictors --------------------------------------------------
model_key <- stress %>% pivot_longer(c(frequency_days, persistence_days, cumulative_hours),
  names_to = "metric_column", values_to = "exposure_value") %>%
  mutate(Metric = recode(metric_column, frequency_days = "Frequency",
                         persistence_days = "Persistence", cumulative_hours = "Cumulative"),
         Environment = str_to_title(environment), Threshold = threshold,
         variable = paste(threshold_id, metric_column, sep = "_"))
if (n_distinct(model_key$variable) != 27) stop("Expected 27 threshold-metric predictors.")
site_scaling <- model_key %>% group_by(variable) %>% summarise(
  predictor_mean = mean(exposure_value), predictor_sd = sd(exposure_value),
  n_unique = n_distinct(exposure_value), .groups = "drop")
write_csv(site_scaling, file.path(output_dir, "GLMM_predictor_scaling.csv"))
model_key <- model_key %>% left_join(site_scaling, by = "variable") %>%
  mutate(z = if_else(is.finite(predictor_sd) & predictor_sd > 0,
                     (exposure_value - predictor_mean) / predictor_sd, NA_real_))

# 04. Fit models ----------------------------------------------------------
control <- glmerControl(optimizer = "bobyqa", optCtrl = list(maxfun = 200000))
null_model <- glmer(heterozygosity ~ 1 + (1 | locus), data = response,
                   family = binomial(link = "logit"), control = control)
fit_one <- function(key) {
  predictor <- model_key %>% filter(variable == key) %>% select(site, z)
  d <- response %>% left_join(predictor, by = "site")
  if (anyNA(dz)||ndistinct(dz) < 2) return(tibble(variable = key,
    Beta = NA_real_, SE = NA_real_, z_stat = NA_real_, p = NA_real_,
    CI_lower = NA_real_, CI_upper = NA_real_, Odds_ratio = NA_real_, AIC = NA_real_,
    singular = NA, convergence = "Insufficient site variation"))
  tryCatch({
    fit <- glmer(heterozygosity ~ z + (1 | locus), data = d,
                 family = binomial(link = "logit"), control = control)
    co <- summary(fit)$coefficients["z", ]
    beta <- unname(co["Estimate"]); se <- unname(co["Std. Error"])
    tibble(variable = key, Beta = beta, SE = se, z_stat = unname(co["z value"]),
           p = unname(co["Pr(>|z|)"]), CI_lower = beta - 1.96 * se,
           CI_upper = beta + 1.96 * se, Odds_ratio = exp(beta), AIC = AIC(fit),
           singular = isSingular(fit), convergence = if (is.null(fit@optinfoconvlme4$messages))
             "OK" else paste(fit@optinfoconvlme4$messages, collapse = "; "))
  }, error = function(e) tibble(variable = key, Beta = NA_real_, SE = NA_real_,
    z_stat = NA_real_, p = NA_real_, CI_lower = NA_real_, CI_upper = NA_real_,
    Odds_ratio = NA_real_, AIC = NA_real_, singular = NA,
    convergence = conditionMessage(e)))
}
fits <- map_dfr(unique(model_key$variable), fit_one)
if (!any(is.finite(fits$AIC))) stop("No GLMMs could be fitted.")
glmm_results <- model_key %>% distinct(variable, Environment, Metric, Threshold, threshold_id) %>%
  left_join(fits, by = "variable") %>% mutate(Null_AIC = AIC(null_model),
    Delta_AIC = AIC - min(AIC, na.rm = TRUE), AIC_improvement_over_null = Null_AIC - AIC,
    AIC_support = case_when(is.na(Delta_AIC) ~ "Not fitted", Delta_AIC <= 2 ~ "0–2",
      Delta_AIC <= 7 ~ "2–7", Delta_AIC <= 10 ~ "7–10", Delta_AIC <= 20 ~ "10–20",
      Delta_AIC <= 30 ~ "20–30", TRUE ~ ">30")) %>% arrange(AIC)
write_csv(glmm_results, file.path(output_dir, "GLMM_27_model_results.csv"))

# 05. Forest plots --------------------------------------------------------
plot_data <- glmm_results %>% filter(is.finite(Beta)) %>%
  mutate(AIC_support = factor(AIC_support, levels = c("0–2", "2–7", "7–10", "10–20", "20–30", ">30")))
for (metric_name in c("Frequency", "Persistence", "Cumulative")) {
  p <- plot_data %>% filter(Metric == metric_name) %>%
    ggplot(aes(Beta, reorder(paste(Environment, Threshold), Beta),
               color = Environment, shape = AIC_support)) +
    geom_vline(xintercept = 0, linetype = "dashed", color = "grey60") +
    geom_segment(aes(x = CI_lower, xend = CI_upper, yend = reorder(paste(Environment, Threshold), Beta))) +
    geom_point(size = 3) + labs(x = "Standardized log-odds coefficient (95% Wald CI)",
                               y = NULL, shape = "ΔAIC") + theme_classic(base_size = 12)
  ggsave(file.path(output_dir, paste0("GLMM_forest_", tolower(metric_name), ".png")),
         p, width = 11, height = 7, dpi = 300)
}
print(glmm_results, n = Inf, width = Inf)

