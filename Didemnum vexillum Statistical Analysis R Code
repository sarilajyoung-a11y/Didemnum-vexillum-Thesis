ar_hourly <- ar_raw %>% transmute(datetime = parse_date_time(as.character(datetime),
 orders = c("ymd HMS", "ymd HM", "ymd H"), tz = "UTC"), IVT = as.numeric(IVT)) %>%
 filter(!is.na(datetime), is.finite(IVT)) %>% mutate(date = as.Date(datetime, tz = "UTC"))
if (anyDuplicated(ar_hourly$datetime)) stop("Duplicate hourly IVT timestamps.")
ar_daily <- ar_hourly %>% group_by(date) %>% summarise(max_IVT = max(IVT),
 hours_IVT_250 = sum(IVT >= 250), observed_hours = n(), .groups = "drop") %>%
 mutate(AR_day = observed_hours >= 12 & hours_IVT_250 >= 12,
        AR_strength = case_when(!AR_day ~ "No AR", max_IVT >= 1000 ~ "Extreme AR",
                                max_IVT >= 750 ~ "Strong AR", max_IVT >= 500 ~ "Moderate AR", TRUE ~ "Weak AR"))
precip_ar <- left_join(precip, ar_daily, by = "date")
p95 <- unname(quantile(precip_ar$precipitation_mm, .95, na.rm = TRUE))
p98 <- unname(quantile(precip_ar$precipitation_mm, .98, na.rm = TRUE))
precip_ar <- precip_ar %>% mutate(percentile_class = case_when(
 precipitation_mm > p98 ~ "98th percentile", precipitation_mm > p95 ~ "95th percentile", TRUE ~ NA_character_))
write_csv(precip_ar, file.path(output_dir, "precipitation_IVT_daily.csv"))
p <- ggplot(precip_ar, aes(date, precipitation_mm)) + geom_col(fill = "#9ecae1", width = 1) +
 geom_hline(yintercept = p95, linetype = "dashed") + geom_hline(yintercept = p98) +
 geom_point(data = filter(precip_ar, !is.na(percentile_class)),
 aes(shape = percentile_class, fill = AR_strength), size = 3, color = "black") +
 scale_shape_manual(values = c("95th percentile" = 21, "98th percentile" = 24)) +
 scale_fill_manual(values = c("Weak AR" = "#F3C79E", "Moderate AR" = "#D9791F",
                              "Strong AR" = "#6B3A0A", "Extreme AR" = "#7F0000", "No AR" = "white")) +
 labs(x = "Date", y = "Daily precipitation (mm)", shape = "Precipitation threshold", fill = "IVT event class") + theme_classic(base_size = 12)
save_plot(p, "precipitation_IVT_events.png", 14, 6)

